---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Command from '../components/Command.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/projects';

interface Props {
  title?: string;
  description?: string;
  og?: string;
  footer?: boolean;
}
const {
  title = `${site.name} · ${site.role}`,
  description = 'Krish Gupta builds systems where security and machine learning meet. B.Tech at the University of Delhi, looking for internships.',
  og = '/og/home.png',
  footer = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(og, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0c12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'ivory') document.documentElement.dataset.theme = 'ivory';
      } catch (e) {}
      var c = navigator.connection;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || (c && c.saveData)) document.documentElement.classList.add('lite');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
    <Command />
    <div class="grid-overlay" aria-hidden="true"><div>{Array.from({ length: 12 }).map(() => <i />)}</div></div>
    <script>
      import '../scripts/core';
    </script>
  </body>
</html>

<style>
  .skip { position: fixed; left: 12px; top: -60px; z-index: 100; background: var(--gold); color: var(--bg); padding: 10px 14px; border-radius: 8px; font: 600 14px/1 var(--body); }
  .skip:focus { top: 12px; }
</style>

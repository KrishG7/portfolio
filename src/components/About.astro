---
import { site } from '../data/projects';

// GitHub's public contribution calendar, read once at build time.
// If GitHub can't be reached the block is simply left out.
let days: { d: string; l: number }[] = [];
try {
  const res = await fetch('https://github.com/users/KrishG7/contributions', { signal: AbortSignal.timeout(8000), headers: { 'User-Agent': 'krish-portfolio-build' } });
  if (res.ok) {
    const html = await res.text();
    for (const m of html.matchAll(/data-date="(\d{4}-\d{2}-\d{2})"[^>]*data-level="(\d)"/g)) days.push({ d: m[1], l: Number(m[2]) });
    days.sort((a, b) => a.d.localeCompare(b.d));
    days = days.slice(-26 * 7);
  }
} catch {}

const path = [
  { at: 'Rajouri, J&K', t: 'Where I’m from. A small town in the hills.' },
  { at: 'Badhani, Pathankot', t: 'Boarding school, class 5 to 12. House Captain and valedictorian, captain of the football and volleyball teams, and awarded the Red Coat.' },
  { at: 'New Delhi', t: 'B.Tech at the Faculty of Technology, University of Delhi, in blockchain, cybersecurity and machine learning. Batch of 2028.' },
  { at: 'Next', t: 'Quantum computing. I haven’t started yet, which is exactly why it’s on the list.' },
];
---
<section class="about" id="about" data-x="about · story + photo stack">
  <div class="wrap grid">
    <div class="photos" data-stack aria-label="Photos of Krish">
      <figure style="--r:-4deg;--i:2"><img src="/img/about-hills.webp" alt="Krish in a brown jacket on a hillside above a pine valley" width="825" height="1100" loading="lazy" decoding="async" /></figure>
      <figure style="--r:3deg;--i:1"><img src="/img/about-snow.webp" alt="Krish smiling on a snowy mountain road" width="825" height="1100" loading="lazy" decoding="async" /></figure>
      <figure style="--r:-1deg;--i:0"><img src="/img/about-profile.webp" alt="Krish in profile, curly hair, black t-shirt" width="825" height="1100" loading="lazy" decoding="async" /></figure>
      <button type="button" class="shuffle" data-shuffle>Shuffle <i aria-hidden="true">↻</i></button>
    </div>

    <div class="words">
      <p class="eyebrow">03 <b>·</b> About</p>
      <h2 class="h-section">The short <em>version.</em></h2>
      <div class="body">
        <p>I’m Krish. I grew up between a small town in Jammu and Kashmir and a boarding school in Punjab, and I’m now in Delhi doing a B.Tech in blockchain, cybersecurity and machine learning.</p>
        <p>I like to lead, I like to compete, and I like problems I don’t know how to solve yet. If I haven’t done something before, I learn it from the start, and I keep going until it holds up.</p>
        <p>Right now that’s <a href="/work/aegis-tensor">{site.now}</a>, where my two interests meet: making sure the machine-learning models people download can’t be turned against them. Away from the screen it’s sport and the gym.</p>
      </div>

      <ol class="path">
        {path.map((p, i) => (
          <li>
            <span class="dot" aria-hidden="true"></span>
            <span class="at">{p.at}</span>
            <span class="t">{p.t}</span>
          </li>
        ))}
      </ol>

      {days.length > 0 && (
        <div class="cal" aria-label="GitHub activity over the last six months">
          <p class="eyebrow">Commits <b>·</b> last six months</p>
          <div class="cells">{days.map((d) => <i class={`l${d.l}`} title={d.d}></i>)}</div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .about { padding-block: clamp(96px, 14vw, 180px); border-top: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 120px); align-items: start; }

  .photos { position: sticky; top: 96px; aspect-ratio: 3 / 4; max-width: 460px; width: 100%; }
  figure { position: absolute; inset: 0; margin: 0; border-radius: 10px; overflow: hidden; transform: rotate(var(--r)) translateY(calc(var(--i) * -6px)); z-index: calc(3 - var(--i)); box-shadow: 0 20px 60px rgba(0, 0, 0, .35); transition: transform .8s var(--ease), z-index 0s .3s; background: var(--bg-2); }
  figure img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.85) contrast(1.02); }
  .photos:hover figure:nth-child(1) { transform: rotate(-9deg) translate(-26px, -10px); }
  .photos:hover figure:nth-child(2) { transform: rotate(7deg) translate(24px, -4px); }
  .shuffle { position: absolute; z-index: 5; right: 12px; bottom: 12px; font: 500 12px/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; padding: 10px 14px; border-radius: 99px; background: rgba(10, 12, 18, .7); color: #efe8da; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); min-height: 40px; }

  .body { margin-top: 40px; display: grid; gap: 20px; font-size: clamp(18px, 1.45vw, 21px); line-height: 1.6; color: var(--ink-2); max-width: 60ch; }
  .body p { margin: 0; }
  .body a { color: var(--gold); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }

  .path { list-style: none; margin: 64px 0 0; padding: 0; position: relative; display: grid; gap: 28px; }
  .path::before { content: ''; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 1px; background: linear-gradient(var(--gold), var(--line)); }
  .path li { position: relative; display: grid; grid-template-columns: 180px 1fr; gap: 6px 24px; padding-left: 32px; }
  .dot { position: absolute; left: 0; top: 6px; width: 11px; height: 11px; border-radius: 50%; border: 1px solid var(--gold); background: var(--bg); }
  .path li:last-child .dot { background: var(--gold); }
  .at { font: 500 12px/1.6 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink); }
  .t { color: var(--ink-2); font-size: 16px; line-height: 1.55; }

  .cal { margin-top: 64px; }
  .cells { margin-top: 16px; display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 10px); gap: 3px; overflow-x: auto; }
  .cells i { width: 10px; height: 10px; border-radius: 2px; background: var(--line); }
  .cells .l1 { background: color-mix(in srgb, var(--gold) 30%, var(--line)); }
  .cells .l2 { background: color-mix(in srgb, var(--gold) 55%, var(--line)); }
  .cells .l3 { background: color-mix(in srgb, var(--gold) 80%, var(--line)); }
  .cells .l4 { background: var(--gold); }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .photos { position: relative; top: 0; max-width: 340px; margin-inline: auto; width: 82%; }
    .path li { grid-template-columns: 1fr; }
  }
</style>

<script>
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  stack?.querySelector('[data-shuffle]')?.addEventListener('click', () => {
    const figs = [...stack.querySelectorAll<HTMLElement>('figure')];
    figs.forEach((f) => { const i = Number(f.style.getPropertyValue('--i')); f.style.setProperty('--i', String((i + 2) % 3)); });
  });
</script>

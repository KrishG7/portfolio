---
import { minors, areaLabel, type Area } from '../data/projects';
const areas = [...new Set(minors.flatMap((m) => m.areas))] as Area[];
---
<section class="archive" id="archive" data-x="archive · filterable grid">
  <div class="wrap">
    <div class="top">
      <div>
        <p class="eyebrow">02 <b>·</b> Archive</p>
        <h2 class="h-section">Everything <em>else</em><br />I’ve shipped.</h2>
      </div>
      <div class="chips" role="group" aria-label="Filter by area" data-filter>
        <button type="button" aria-pressed="true" data-f="all">All <span>{minors.length}</span></button>
        {areas.map((a) => <button type="button" aria-pressed="false" data-f={a}>{areaLabel[a]} <span>{minors.filter((m) => m.areas.includes(a)).length}</span></button>)}
      </div>
    </div>
    <ul class="grid" data-grid>
      {minors.map((m, i) => (
        <li data-areas={m.areas.join(' ')}>
          <a href={m.repo} target="_blank" rel="noopener">
            <span class="n">{String(i + 5).padStart(2, '0')}</span>
            <h3>{m.name}</h3>
            <p>{m.line}</p>
            <span class="tags">{m.stack.join(' · ')}</span>
            <span class="go" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .archive { padding-block: clamp(96px, 14vw, 180px); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 32px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips button { font: 500 13px/1 var(--body); padding: 11px 16px; border-radius: 99px; border: 1px solid var(--line-2); color: var(--ink-2); transition: all .3s var(--ease); min-height: 44px; }
  .chips button span { font: 500 11px/1 var(--mono); color: var(--ink-3); margin-left: 4px; }
  .chips button[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .chips button[aria-pressed='true'] span { color: var(--bg); opacity: .6; }
  .grid { list-style: none; margin: clamp(48px, 6vw, 80px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 12px; }
  .grid li { border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; transition: border-color .4s var(--ease); }
  .grid li:hover { border-color: color-mix(in srgb, var(--gold) 55%, transparent); }
  .grid li[hidden] { display: none; }
  .grid a { position: relative; display: flex; flex-direction: column; gap: 12px; height: 100%; padding: 28px; transition: background .4s var(--ease); }
  .grid a:hover { background: var(--bg-2); }
  .n { font: 500 12px/1 var(--mono); color: var(--gold); }
  h3 { margin: 4px 0 0; font: 380 34px/1 var(--display); font-variation-settings: 'opsz' 96; letter-spacing: -.02em; }
  p { margin: 0; color: var(--ink-2); font-size: 16px; line-height: 1.5; }
  .tags { margin-top: auto; padding-top: 12px; font: 500 11px/1.5 var(--mono); letter-spacing: .06em; color: var(--ink-3); }
  .go { position: absolute; right: 24px; top: 24px; font-size: 18px; color: var(--ink-3); transition: transform .4s var(--ease), color .3s; }
  .grid a:hover .go { color: var(--gold); transform: translate(3px, -3px); }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-filter]')!;
  const items = document.querySelectorAll<HTMLLIElement>('[data-grid] li');
  box.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    const f = b.dataset.f!;
    box.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const apply = () => items.forEach((li) => (li.hidden = f !== 'all' && !li.dataset.areas!.split(' ').includes(f)));
    const d = document as any;
    if (d.startViewTransition && !document.documentElement.classList.contains('lite')) d.startViewTransition(apply); else apply();
  });
</script>

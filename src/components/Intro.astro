---
import { site } from '../data/projects';
const lines = [
  'Hand me something I have never done.',
  'I will learn it from the first principle,',
  'build it until it holds, test it until it breaks,',
  'and fix it properly. I don’t plan on being outshone.',
];
---
<section class="intro" data-x="intro · decode lines">
  <div class="wrap">
    <p class="eyebrow">00 <b>·</b> Statement</p>
    <p class="say">
      {lines.map((l, i) => <span class="ln" data-decode={String(700 + i * 120)}>{l}</span>)}
    </p>
    <ul class="strip" aria-label="At a glance">
      <li><span class="k">Major</span><span class="v">Blockchain, Cybersecurity &amp; ML</span></li>
      <li><span class="k">Working on</span><span class="v"><i class="live"></i>{site.now}</span></li>
      <li><span class="k">Base</span><span class="v">New Delhi, India</span></li>
      <li><span class="k">Looking for</span><span class="v">2027 internships</span></li>
    </ul>
  </div>
</section>

<style>
  .intro { padding-block: clamp(120px, 18vw, 240px) clamp(80px, 12vw, 160px); }
  .say {
    margin: 28px 0 0; max-width: 22ch;
    font: 340 clamp(34px, 5.4vw, 84px)/1.06 var(--display); font-variation-settings: 'opsz' 144; letter-spacing: -.025em;
  }
  .ln { display: block; }
  .ln:nth-child(2) { color: var(--ink-2); }
  .ln:nth-child(3) { color: var(--ink-2); }
  .ln:last-child { font-style: italic; color: var(--gold); }
  .say { max-width: none; }
  .ln { max-width: 26ch; }
  .strip { list-style: none; margin: clamp(64px, 9vw, 120px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .strip li { padding: 20px 20px 0 0; display: grid; gap: 8px; }
  .strip li + li { padding-left: 20px; border-left: 1px solid var(--line); }
  .k { font: 500 11px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); }
  .v { font-size: 16px; color: var(--ink); display: inline-flex; align-items: center; gap: 8px; }
  .live { width: 7px; height: 7px; border-radius: 50%; background: #5fd38d; box-shadow: 0 0 0 0 rgba(95, 211, 141, .6); animation: beat 2s infinite; }
  @keyframes beat { 70% { box-shadow: 0 0 0 8px rgba(95, 211, 141, 0); } 100% { box-shadow: 0 0 0 0 rgba(95, 211, 141, 0); } }
  @media (max-width: 860px) {
    .strip { grid-template-columns: 1fr 1fr; }
    .strip li:nth-child(3) { padding-left: 0; border-left: 0; }
    .strip li:nth-child(n + 3) { padding-top: 20px; margin-top: 20px; border-top: 1px solid var(--line); }
  }
</style>

---
import { site } from '../data/projects';
const year = new Date().getFullYear();
---
<footer class="foot" id="contact" data-x="contact · giant email + lens footer">
  <div class="wrap">
    <p class="eyebrow">Contact <b>·</b> internships, research, anything worth building</p>
    <button class="mail" type="button" data-copy={site.email} aria-label={`Copy ${site.email}`}>
      <span class="addr">{site.email.split('@')[0]}<em>@gmail.com</em></span>
      <span class="hint" data-copy-hint>Click to copy</span>
    </button>
    <div class="row">
      <a href={site.github} target="_blank" rel="noopener">GitHub</a>
      <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={site.leetcode} target="_blank" rel="noopener">LeetCode</a>
      <a href="/cv">CV</a>
    </div>
  </div>
  <div class="lens" data-lens aria-hidden="true">
    <span class="base">Krish Gupta</span>
    <span class="lit">Krish Gupta</span>
  </div>
  <div class="wrap legal">
    <span>© {year} Krish Gupta</span>
    <span>Built by hand in Delhi · <button type="button" data-cmdk-open>⌘K</button></span>
  </div>
</footer>

<style>
  .foot { padding-top: clamp(96px, 16vw, 200px); border-top: 1px solid var(--line); overflow: hidden; }
  .mail { display: block; text-align: left; margin-top: 28px; width: 100%; }
  .addr {
    display: block;
    font: 340 clamp(34px, 8.6vw, 148px)/.95 var(--display); font-variation-settings: 'opsz' 144; letter-spacing: -.035em;
    overflow-wrap: anywhere; transition: color .4s var(--ease);
  }
  .addr em { font-style: italic; color: var(--ink-3); transition: color .4s var(--ease); }
  .mail:hover .addr, .mail:hover .addr em { color: var(--gold); }
  .hint { display: inline-block; margin-top: 18px; font: 500 12px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
  .row { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 56px; font: 500 13px/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .row a { color: var(--ink-2); padding-block: 8px; }
  .row a:hover { color: var(--gold); }

  .lens {
    position: relative; margin-top: clamp(64px, 10vw, 140px);
    font: 400 clamp(64px, 19vw, 320px)/.82 var(--display); font-variation-settings: 'opsz' 144; letter-spacing: -.05em;
    white-space: nowrap; text-align: center; user-select: none;
    --x: 50%; --y: 50%; --r: 0px;
  }
  .lens span { display: block; }
  .base { color: transparent; -webkit-text-stroke: 1px var(--line-2); }
  .lit {
    position: absolute; inset: 0; color: var(--gold); font-style: italic;
    -webkit-mask: radial-gradient(circle var(--r) at var(--x) var(--y), #000 98%, transparent 100%);
    mask: radial-gradient(circle var(--r) at var(--x) var(--y), #000 98%, transparent 100%);
    transition: --r .3s;
  }
  .legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding-block: 28px max(28px, calc(env(safe-area-inset-bottom) + 84px)); font: 500 12px/1.4 var(--mono); color: var(--ink-3); }
  .legal button { font: inherit; color: var(--ink-2); text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 761px) { .legal { padding-bottom: 28px; } }
</style>

---
import Base from '../layouts/Base.astro';
import { flagships, minors, others, site } from '../data/projects';

// which caption step is the moment the threat shows up
const journey = [
  { place: 'Rajouri', where: 'Delhi Public School, Rajouri', coord: '33.38° N  74.31° E', when: 'Where I’m from', text: 'A small town in the hills of Jammu and Kashmir, and where I grew up. My first years of school were at Delhi Public School, Rajouri.' },
  { place: 'Badhani', where: 'Dalhousie Public School, Badhani', coord: '32.27° N  75.65° E', when: 'Class 5 – 12', text: 'Classes 5 to 12 at a boarding school near Pathankot, Punjab, where I was House Captain, valedictorian and captain of the football and volleyball teams, and received the Red Coat. It taught me to lead, and to keep going when it’s hard.' },
  { place: 'New Delhi', where: 'University of Delhi', coord: '28.61° N  77.21° E', when: '2024 – 2028', text: 'B.Tech in blockchain, cybersecurity and machine learning at the Faculty of Technology. This is where the projects on this page were built.' },
];
---
<Base film>
  <svg class="rope" data-rope aria-hidden="true"><path class="glow" /><circle class="halo" r="16" /><circle class="tip" r="3.5" /></svg>

  <!-- 1 · ABOUT ME → dust → portrait and name → about -->
  <section id="about" class="ch" data-where="About me" aria-labelledby="h-about">
    <div class="stage" id="s1">
      <h2 id="h-about" class="sr">About me</h2>
      <div class="intro-foot wrap tag" data-intro-hint><span>Krish Gupta · Portfolio 2026</span><span>Scroll</span></div>
      <div class="face-box" id="s1face"></div>
      <h1 class="name poster" data-name aria-label="Krish Gupta"><span data-name-chars>Krish Gupta</span></h1>
      <div class="about wrap" data-about>
        <div class="col-a">
          <p class="poster about-name" data-name-target aria-hidden="true">Krish Gupta</p>
          <p class="statement" data-about-line>I build software that has to work in the real world, from model security to clinics to farms.</p>
        </div>
        <div class="col-b">
          <p data-about-line>I’m Krish, a B.Tech student at the University of Delhi studying blockchain, cybersecurity and machine learning. My projects range from machine-learning security to healthcare software, developer tools and farm tech. What connects them is that I pick up whatever the problem needs and build it all the way through.</p>
          <p data-about-line>I like learning things properly, from the ground up, and I enjoy leading a team and learning from the people around me. Away from the screen you’ll find me at the gym, or on a football or volleyball field.</p>
          <p class="tag" data-about-line><span class="dot"></span>Now building <b>{site.now}</b> · open to 2027 internships</p>
        </div>
      </div>
    </div>
    <div class="marks">
      <div data-film="text" data-text="About me" data-anchor="#s1" data-rope="0:.06 .3:.1 .62:.5 .9:.88"></div>
      <div data-film="dust" data-rope=".4:.72 .85:.3"></div>
      <div data-film="face" data-anchor="#s1" data-box="#s1face" data-rope=".35:.1 .8:.08"></div>
      <div data-film="haze" style="--h:220svh" data-rope=".12:.34 .45:.05 .85:.5"></div>
    </div>
  </section>

  <!-- 2 · PROJECTS → one full screen per project -->
  <section id="work" class="ch" data-where="Projects" aria-labelledby="h-work">
    <div class="stage" id="s2">
      <h2 id="h-work" class="sr">Projects</h2>
      <p class="ch-cap wrap tag" data-ch-cap>Four systems · 2026 · from four different corners of the field</p>
      <div class="fig-box" id="pfig"></div>
      {flagships.map((f, i) => (
        <article class="slide wrap" data-slide aria-labelledby={`p-${f.slug}`}>
          <div class="txt">
            <p class="tag a"><span class="ix">0{i + 1}</span> / 0{flagships.length} · {f.area}</p>
            <h3 id={`p-${f.slug}`} class="poster pname" data-lines set:html={f.name.replace('-', '-<br />')} />
            <p class="hook a">{f.hook}</p>
            <p class="body a">{f.body}</p>
            <ul class="chips a">{f.stack.slice(0, 5).map((s) => <li>{s}</li>)}</ul>
            <div class="row a">
              <a class="btn" href={f.repo} target="_blank" rel="noopener" data-magnetic data-roll data-cursor-text="Source">Source ↗</a>
              {f.team && <span class="tag">Team · {f.team}</span>}
            </div>
          </div>
          <div class="fig-foot tag a">
            <span class="cap" data-cap={JSON.stringify(f.caps)}>{f.caps[0]}</span>
            <span class="prog"><i data-prog></i></span>
          </div>
        </article>
      ))}
    </div>
    <div class="marks">
      <div data-film="text" data-text="Projects" data-anchor="#s2" data-rope=".3:.92 .62:.5 .9:.1"></div>
      {flagships.map((f, i) => (
        <div data-film={f.film} data-anchor="#s2" data-box="#pfig" data-slide-mark style="--h:170svh" data-rope={i % 2 ? '.2:.47 .55:.43 .9:.46' : '.2:.43 .55:.47 .9:.44'} data-rope-m=".2:.95 .55:.9 .9:.95"></div>
      ))}
    </div>
  </section>

  <!-- 3 · ARCHIVE -->
  <section id="archive" class="ch" data-where="Archive" aria-labelledby="h-arch">
    <div class="stage" id="s3">
      <h2 id="h-arch" class="sr">Archive</h2>
      <div class="slide list wrap" data-slide>
        <p class="tag a">Also built · {minors.length} more</p>
        <ul class="rows">
          {minors.map((m, i) => (
            <li class="a">
              <a href={m.slug ? `/work/${m.slug}` : m.repo} target={m.slug ? undefined : "_blank"} rel={m.slug ? undefined : "noopener"} data-cursor-text={m.slug ? "Case study" : "Source"}>
                <span class="tag n">0{i + 5}</span>
                <span class="poster nm">{m.name}</span>
                <span class="ln">{m.line}</span>
                <span class="tag st">{m.stack.join(' · ')}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="more a">
          <p class="tag">Other projects on GitHub</p>
          <ul class="mini">
            {others.map((o) => (
              <li><a href={o.repo} target="_blank" rel="noopener" data-cursor-text="Source"><b>{o.name} <i>{o.year}</i></b><span>{o.line}</span></a></li>
            ))}
          </ul>
          <a class="tag all" href={site.github} target="_blank" rel="noopener" data-roll>All repositories on GitHub ↗</a>
        </div>
      </div>
    </div>
    <div class="marks">
      <div data-film="text" data-text="Archive" data-anchor="#s3" data-rope=".3:.08 .62:.5 .9:.92"></div>
      <div data-film="haze" data-slide-mark style="--h:170svh" data-rope=".15:.97 .5:.02 .85:.97"></div>
    </div>
  </section>

  <!-- 4 · JOURNEY -->
  <section id="journey" class="ch" data-where="Journey" aria-labelledby="h-jour">
    <div class="stage" id="s4">
      <h2 id="h-jour" class="sr">Journey</h2>
      <div class="fig-box" id="jfig"></div>
      {journey.map((j, i) => (
        <article class="slide wrap" data-slide>
          <div class="txt">
            <p class="tag a"><span class="ix">0{i + 1}</span> / 0{journey.length} · {j.when}</p>
            <h3 class="poster pname" data-lines>{j.place}</h3>
            <p class="hook a">{j.where}</p>
            <p class="body a">{j.text}</p>
            <p class="coord tag a">{j.coord}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="marks">
      <div data-film="text" data-text="Journey" data-anchor="#s4" data-rope=".3:.9 .62:.5 .9:.15"></div>
      {journey.map((_, i) => (
        <div data-film="route" data-active={i} data-anchor="#s4" data-box="#jfig" data-slide-mark style="--h:130svh" data-rope=".3:.46 .75:.5" data-rope-m=".3:.95 .75:.92"></div>
      ))}
    </div>
  </section>

  <!-- 5 · CONTACT -->
  <section id="contact" class="ch last" data-where="Contact" aria-labelledby="h-contact">
    <div class="stage" id="s5">
      <h2 id="h-contact" class="sr">Contact</h2>
      <div class="slide contact wrap" data-slide>
        <p class="tag a">Internships · research · anything that has to hold</p>
        <p class="poster big" data-lines>Let’s build<br />something<br />that holds.</p>
        <button class="mail a" type="button" data-copy={site.email} data-cursor-text="Copy" aria-label={`Copy ${site.email}`}>
          <span class="addr" id="mailaddr">{site.email}</span>
          <span class="tag" data-copy-hint>Click to copy</span>
        </button>
        <div class="foot a">
          <nav class="tag" aria-label="Elsewhere">
            <a href={site.github} target="_blank" rel="noopener" data-magnetic data-roll>GitHub</a>
            <a href={site.linkedin} target="_blank" rel="noopener" data-magnetic data-roll>LinkedIn</a>
            <a href={site.leetcode} target="_blank" rel="noopener" data-magnetic data-roll>LeetCode</a>
            <a href="/KrishGupta_CV.pdf" download data-magnetic data-roll>CV</a>
          </nav>
          <p class="tag">© 2026 Krish Gupta · press <b>⌘K</b></p>
        </div>
      </div>
    </div>
    <div class="marks">
      <div data-film="text" data-text="Contact" data-anchor="#s5" data-rope=".3:.9 .62:.5 .92:.06"></div>
      <div data-film="haze" data-slide-mark data-rope=".25:.025" data-rope-m=".25:.03" data-rope-end="#mailaddr"></div>
    </div>
  </section>
</Base>

<style>
  /* chapters: a sticky full-screen stage, with the scroll length set by the markers under it */
  .ch { position: relative; }
  .stage { position: sticky; top: 0; height: 100svh; overflow: clip; z-index: 3; }
  .marks { margin-top: -100svh; pointer-events: none; }
  .marks > div { height: var(--h, 100svh); }
  .ch.last .marks > div:last-child { height: 100svh; }

  .rope { position: fixed; inset: 0; width: 100vw; height: 100lvh; z-index: 2; pointer-events: none; overflow: visible; }
  .rope path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .rope { filter: drop-shadow(0 0 9px rgba(255, 45, 77, .6)); }
  .rope .glow { stroke: #ff2d4d; stroke-width: 26; opacity: .42; filter: blur(10px); }
  .rope .tip { fill: #fff3f5; r: 7; }
  .rope .halo { fill: none; stroke: var(--crimson); stroke-width: 1; opacity: .6; transform-box: fill-box; transform-origin: center; animation: halo 2s var(--ease) infinite; }
  @keyframes halo { 0% { transform: scale(.4); opacity: .9; } 100% { transform: scale(1.8); opacity: 0; } }

  /* 1 */
  .intro-foot { position: absolute; left: 0; right: 0; bottom: max(26px, env(safe-area-inset-bottom)); display: flex; justify-content: space-between; }
  .face-box { position: absolute; left: 50%; top: 3svh; width: min(84vw, 96svh); height: 88svh; transform: translateX(-50%); }
  .name {
    position: absolute; left: 0; right: 0; bottom: 5svh; margin: 0 auto; width: fit-content; text-align: center; white-space: nowrap;
    font-size: clamp(64px, 14.5vw, 280px); line-height: .82; color: var(--ink); transform-origin: 0 0;
  }
  .about { position: absolute; inset: 0; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(24px, 5vw, 96px); align-content: center; padding-block: 90px 60px; }
  .about-name { visibility: hidden; font-size: clamp(56px, 7.4vw, 140px); line-height: .84; margin: 0 0 32px; white-space: nowrap; }
  .statement { margin: 0; font-size: clamp(24px, 2.6vw, 44px); line-height: 1.15; letter-spacing: -.01em; max-width: 24ch; }
  .col-b { display: grid; gap: 18px; align-content: end; color: var(--ink-2); font-size: clamp(16px, 1.25vw, 19px); }
  .col-b p { margin: 0; max-width: 52ch; }
  .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--cut); margin-right: 8px; vertical-align: 1px; }

  /* 2 and 4: slides */
  .ch-cap { position: absolute; left: 0; right: 0; bottom: max(28px, env(safe-area-inset-bottom)); text-align: center; }
  .slide { position: absolute; inset: 0; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: 1fr auto; column-gap: clamp(24px, 4vw, 72px); align-items: center; padding-block: 84px 32px; visibility: hidden; }
  .txt { display: grid; gap: 18px; align-content: center; }
  .ix { color: var(--ink); }
  .pname { font-size: clamp(64px, 8.4vw, 170px); }
  .hook { margin: 0; font-size: clamp(21px, 1.8vw, 28px); line-height: 1.25; max-width: 24ch; }
  .body { margin: 0; color: var(--ink-3); max-width: 46ch; font-size: 16px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .chips li { font: 500 11px/1 var(--mono); padding: 7px 9px; border: 1px solid var(--line-2); border-radius: 99px; color: var(--ink-2); }
  .row { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .fig-box { position: absolute; right: var(--gutter); top: 14svh; width: min(54vw, 980px); height: 64svh; }
  .fig-foot { grid-column: 2; grid-row: 2; display: grid; grid-template-columns: 1fr minmax(80px, 200px); gap: 16px; align-items: center; border-top: 1px solid var(--line); padding-top: 12px; }
  .cap { color: var(--ink); }
  .prog { height: 2px; background: var(--line); position: relative; }
  .prog i { position: absolute; inset: 0; background: var(--cut); transform-origin: left; transform: scaleX(0); }
  .coord { color: var(--ink); letter-spacing: .1em; }

  /* 3: archive list */
  .list { display: flex; flex-direction: column; justify-content: center; align-items: stretch; gap: 24px; }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows li { border-bottom: 1px solid var(--line); }
  .rows a { position: relative; display: grid; grid-template-columns: 60px minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr); gap: 20px; align-items: center; padding-block: clamp(14px, 2.4svh, 26px); isolation: isolate; }
  .rows a::before { content: ''; position: absolute; inset: 0 calc(-1 * var(--gutter)); z-index: -1; background: var(--ink); clip-path: inset(100% 0 0 0); transition: clip-path .55s var(--ease-io); }
  .rows a:hover::before { clip-path: inset(0); }
  .rows a:hover * { color: var(--bg); }
  .nm { font-size: clamp(36px, 4.4vw, 80px); line-height: .9; transition: color .3s; }
  .ln { color: var(--ink-2); font-size: 15px; line-height: 1.45; transition: color .3s; }
  .st { text-align: right; transition: color .3s; }

  /* 5: contact */
  .contact { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 22px; }
  .contact .foot { align-self: stretch; }
  .big { margin: 0; }
  .mail { display: block; text-align: left; max-width: 100%; margin-top: 12px; }
  .addr { display: inline-block; font: 400 clamp(28px, 5vw, 96px)/1 var(--display); text-transform: uppercase; overflow-wrap: anywhere; color: var(--cut); transition: color .4s var(--ease); }
  .mail:hover .addr { color: var(--gold-2); }
  .mail .tag { display: block; margin-top: 18px; }
  .big { font-size: clamp(48px, min(9.6vw, 15svh), 190px); }

  .foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-top: clamp(24px, 5svh, 64px); padding-top: 18px; border-top: 1px solid var(--line); }
  .foot nav { display: flex; gap: 24px; flex-wrap: wrap; color: var(--ink); }
  .foot p { margin: 0; }

  @media (max-width: 820px) {
    .face-box { width: 112vw; top: 8svh; height: 62svh; }
    .name { bottom: 16svh; font-size: clamp(56px, 17vw, 120px); }
    .about { grid-template-columns: 1fr; align-content: start; gap: 18px; padding-block: 80px 90px; }
    .about-name { font-size: clamp(44px, 13vw, 80px); margin-bottom: 18px; }
    .statement { font-size: 22px; }
    .col-b { font-size: 15px; gap: 12px; align-content: start; }
    .col-b p:nth-child(2) { display: none; }
    .slide { display: flex; flex-direction: column; justify-content: flex-end; padding-block: 0 92px; }
    .fig-box { left: var(--gutter); right: var(--gutter); width: auto; top: 13svh; height: 29svh; }
    .txt { gap: 12px; }
    .pname { font-size: clamp(52px, 15vw, 96px); }
    .hook { font-size: 18px; }
    .body { font-size: 14.5px; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
    .fig-foot { position: absolute; left: var(--gutter); right: var(--gutter); top: calc(13svh - 34px); border-top: 0; padding-top: 0; }
    .chips { display: none; }
    .rows a { grid-template-columns: 30px 1fr; gap: 4px 12px; }
    .ln, .st { grid-column: 2; text-align: left; }
    .ln { font-size: 13.5px; }
    .st { display: none; }
    .list { justify-content: center; padding-block: 70px 90px; }
    .contact { padding-block: 70px 96px; justify-content: center; }
  }

  .more { margin-top: clamp(18px, 3vh, 34px); border-top: 1px solid var(--line); padding-top: clamp(12px, 2vh, 20px); }
  .mini { list-style: none; margin: 12px 0 14px; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 28px; }
  .mini a { display: grid; gap: 2px; }
  .mini b { font: 500 13px/1.3 var(--mono); color: var(--ink); letter-spacing: .02em; }
  .mini span { font-size: 13px; line-height: 1.4; color: var(--ink-3); }
  .mini b i { font-style: normal; color: var(--ink-3); font-weight: 400; margin-left: 6px; }
  .mini a:hover b { color: var(--cut); }
  .all { display: inline-block; color: var(--ink-2); }
  .all:hover { color: var(--ink); }
  @media (max-width: 860px) { .mini { grid-template-columns: 1fr; gap: 8px; } .mini span { display: none; } }
</style>

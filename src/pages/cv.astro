---
import Base from '../layouts/Base.astro';
import { allCases, minors, site } from '../data/projects';
const skills = [
  ['Languages', 'Python, C, Go, TypeScript, JavaScript, SQL, MATLAB, VHDL'],
  ['Security', 'Model-file and pickle analysis, Linux ptrace, sandboxing, applied cryptography'],
  ['Machine learning', 'PyTorch, scikit-learn, CNNs, ViTs, time-series forecasting, forecast calibration'],
  ['Systems', 'Docker, WebSockets, FastAPI, Node, Express, SQLite, MySQL, PostgreSQL'],
];
---
<Base title="CV · Krish Gupta" description="Krish Gupta, Security × ML engineer. Education, projects and skills." og="/og/home.png">
  <div class="wrap cv">
    <header>
      <p class="eyebrow">Curriculum vitae</p>
      <h1>Krish Gupta</h1>
      <p class="lede">{site.role}. B.Tech in Blockchain, Cybersecurity &amp; Machine Learning, University of Delhi. Open to 2027 internships.</p>
      <p class="links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.github} target="_blank" rel="noopener">GitHub</a>
        <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <button type="button" onclick="print()">Print / save as PDF</button>
      </p>
    </header>

    <section>
      <h2>Education</h2>
      <div class="row"><div><h3>Faculty of Technology, University of Delhi</h3><p>B.Tech, Blockchain, Cybersecurity &amp; Machine Learning</p><p class="dim">Applied cryptography, ethical hacking in Linux, operating systems, computer networks, theory of computation, AI/ML, digital image processing</p></div><span>2024 – 2028</span></div>
      <div class="row"><div><h3>Daksh Gurukul, IIT Guwahati</h3><p>Credit-linked Data Science certification, year-long</p></div><span>2025 – 2026</span></div>
      <div class="row"><div><h3>The Badhani School, Pathankot</h3><p>House Captain and valedictorian. Awarded the Red Coat. Captain, football and volleyball.</p></div><span>Class 5 – 12</span></div>
    </section>

    <section>
      <h2>Selected work</h2>
      {allCases.map((f) => (
        <div class="row"><div><h3><a href={`/work/${f.slug}`}>{f.name}</a> <small>{f.kicker}</small></h3><p>{f.line}</p><p class="dim">{f.stack.join(' · ')}</p></div><span>{f.year}</span></div>
      ))}
      {minors.filter((m) => !m.slug).map((m) => (
        <div class="row"><div><h3><a href={m.repo} target="_blank" rel="noopener">{m.name}</a></h3><p>{m.line}</p></div><span>{m.year}</span></div>
      ))}
    </section>

    <section>
      <h2>Skills</h2>
      {skills.map(([k, v]) => <div class="row"><div><h3>{k}</h3><p>{v}</p></div></div>)}
    </section>
  </div>
</Base>

<style>
  .cv { padding-block: clamp(120px, 14vw, 170px) 40px; max-width: 980px; }
  h1 { margin: 16px 0 20px; font: 400 clamp(64px, 11vw, 150px)/.88 var(--display); text-transform: uppercase; letter-spacing: -.005em; }
  .links { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 24px; font: 500 13px/1.6 var(--mono); }
  .links a, .links button { color: var(--cut); text-decoration: underline; text-underline-offset: 4px; }
  section { margin-top: 72px; }
  h2 { margin: 0 0 8px; font: 500 12px/1.6 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--cut); }
  .row { display: flex; justify-content: space-between; gap: 24px; padding: 20px 0; border-top: 1px solid var(--line); }
  .row h3 { margin: 0 0 6px; font: 400 24px/1.15 var(--display); text-transform: uppercase; letter-spacing: .01em; }
  .row h3 small { font: 500 11px/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); margin-left: 8px; }
  .row p { margin: 0; color: var(--ink-2); }
  .row .dim { color: var(--ink-3); font-size: 14px; margin-top: 6px; }
  .row > span { flex: none; font: 500 12px/1.8 var(--mono); color: var(--ink-3); }
  @media (max-width: 640px) { .row { flex-direction: column; gap: 6px; } .row > span { order: -1; } }
  @media print {
    :global(.hud), :global(.menu-btn), :global(.foot), :global(.grid-overlay), .links button { display: none !important; }
    :global(.skip), :global(.cursor), :global(canvas) { display: none !important; }
    .links a[href^='http']::after { content: ' · ' attr(href); font-weight: 400; }
    :global(:root) { --bg: #fff; --bg-2: #fff; --ink: #111; --ink-2: #333; --ink-3: #555; --line: #ccc; --cut: #1b2fc7; --gold: #1b2fc7; }
    :global(html), :global(body) { background: #fff !important; color: #111; font-size: 12px; }
    .cv { padding: 14mm; max-width: none; }
    h1 { font-size: 44px; }
    section { margin-top: 22px; }
    .row { padding: 8px 0; break-inside: avoid; }
  }
</style>
